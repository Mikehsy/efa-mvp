# 浏览器自动巡检配置模板（复制为 .ops/browser.env 后填写）
# .ops/browser.env 已被 .gitignore 忽略，不要提交、不要贴聊天。
#
# 登录默认走 agent-browser Auth Vault（凭据加密保存在用户目录，登录选择器自动识别）：
#   powershell -ExecutionPolicy Bypass -File scripts\ops_auth_setup.ps1

# 必填：应用首页完整地址（形如 https://efa-mvp.streamlit.app，不要带空格/分支名）
EFA_APP_URL=https://你的真实应用名.streamlit.app

# 必填：专用巡检账号（当前用 adminbot，为巡检专门注册，不是管理员账号）
EFA_OPS_USERNAME=专用测试账号
EFA_OPS_PASSWORD=专用测试密码

# 可选：Auth Vault profile 名称，默认 efa-ops
EFA_AUTH_PROFILE=efa-ops

# 可选兜底：仅在 Vault 登录失败时使用。留空则由 agent-browser 自动识别。
EFA_LOGIN_USER_SELECTOR=
EFA_LOGIN_PASS_SELECTOR=
EFA_LOGIN_SUBMIT_SELECTOR=
