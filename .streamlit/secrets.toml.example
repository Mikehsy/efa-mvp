# 复制本文件为 .streamlit/secrets.toml 并填入真实值。
# 本地不要把 secrets.toml 提交到 GitHub（.gitignore 已排除）。
# 云端在 Streamlit Cloud → App settings → Secrets 里粘贴同样内容。

# 启用数据库模式（注册登录 + 数据存云端）
EFA_USE_DB = "1"

# Supabase 连接串，格式：
# postgresql://postgres.<项目ref>:<数据库密码>@<地区>.pooler.supabase.com:6543/postgres
# 在 Supabase → Project Settings → Database → Connection string（Session pooler）获取。
# 注意：用你建项目时设的「数据库密码」，不是账号密码。
DATABASE_URL = "postgresql://postgres.xxxxxxxx:YOUR_DB_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"
