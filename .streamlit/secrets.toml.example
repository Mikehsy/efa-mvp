# 复制本文件为 .streamlit/secrets.toml 并填入真实值。
# 本地不要把 secrets.toml 提交到 GitHub（.gitignore 已排除）。
# 云端在 Streamlit Cloud → App settings → Secrets 里粘贴同样内容。

# 启用数据库模式（注册登录 + 数据存云端）
EFA_USE_DB = "1"

# Supabase 连接串，格式：
# postgresql://postgres.<项目ref>:<数据库密码>@<地区>.pooler.supabase.com:5432/postgres
# 在 Supabase 项目右上角 Connect → Connection string → Session pooler → URI 获取。
# 注意：用你建项目时设的「数据库密码」，不是账号密码；端口是 5432。
# 密码含 @ : / # ? % 等特殊字符时必须 URL 编码，建议重置为纯字母数字密码。
DATABASE_URL = "postgresql://postgres.xxxxxxxx:YOUR_DB_PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"

# ---- PIPL 隐私合规配置（正式商用前必须由运营方填写真实值）----
# 真实运营主体全称；不填则注册页与政策页显示「【待填写…】」并给出警示。
EFA_OPERATOR_NAME = "【待填写：运营主体全称】"
# 个人信息保护负责人邮箱或电话，用于受理查阅、更正、删除、投诉。
EFA_PRIVACY_CONTACT = "【待填写：个人信息保护负责人邮箱/电话】"
# 个人信息保存期限（天），自最后一次写入数据起算。
EFA_RETENTION_DAYS = "730"
# 数据库所在境外区域，展示在隐私政策「境外提供」一节。
EFA_OVERSEAS_REGION = "东北亚（东京）"
# 隐私政策版本；变更此值会要求所有用户重新同意。
EFA_POLICY_VERSION = "2026-11-18-v1"
# 政策正文展示的生效日期；变更版本时应同步更新。
EFA_POLICY_EFFECTIVE_DATE = "2026-11-18"
# 去标识化留痕的盐值：上线前设定一个随机长字符串并妥善保管；
# 中途更换会导致历史同意记录无法与账号关联，切勿随意修改。
EFA_PRIVACY_HASH_SALT = "【待填写：随机长字符串，首次上线前设定后不要更改】"
